#!/usr/bin/env php
<?php

require_once __DIR__ . '/bootstrap/app.php';

use Veltrion\Bootstrap\Container;
use Veltrion\Services\RAD\ModuleGenerator;
use Veltrion\Services\AI\AIService;
use Veltrion\Services\AI\PromptManager;
use Veltrion\UseCases\Customer\CreateCustomerUseCase;
use Veltrion\UseCases\Customer\ListCustomersUseCase;

$container = Container::getInstance();
$version = trim(file_exists(__DIR__ . '/VERSION') ? file_get_contents(__DIR__ . '/VERSION') : '1.0.0-alpha');

function printBanner() {
    echo "\033[1;36m";
    echo "╔══════════════════════════════════════════════════════════════════════════╗\n";
    echo "║                         VELTRION PHP FRAMEWORK                           ║\n";
    echo "║                   AI & AGENT-POWERED ECOSYSTEM v1.0                      ║\n";
    echo "║                     Creado por: Maxwell Chacón                           ║\n";
    echo "╚══════════════════════════════════════════════════════════════════════════╝\n";
    echo "\033[0m";
}

$args = array_slice($argv, 1);
$command = $args[0] ?? 'menu';

$aiService = new AIService();

switch ($command) {
    case '--version':
    case '-v':
    case 'version':
        echo "Veltrion Framework PHP v{$version} — por Maxwell Chacón\n";
        break;

    case 'doctor':
        printBanner();
        echo "🔍 \033[1;33mEjecutando diagnóstico del sistema (Veltrion Doctor):\033[0m\n\n";

        // Check PHP
        $phpVer = PHP_VERSION;
        echo "  \033[32m[✓]\033[0m PHP Version: {$phpVer}\n";

        // Check Extensions
        $exts = ['pdo', 'pdo_sqlite', 'mbstring', 'xml', 'curl'];
        foreach ($exts as $ext) {
            if (extension_loaded($ext)) {
                echo "  \033[32m[✓]\033[0m PHP Extension '{$ext}': Instalada\n";
            } else {
                echo "  \033[31m[✗]\033[0m PHP Extension '{$ext}': Faltante\n";
            }
        }

        // Check Python
        $pyVersion = shell_exec('python3 --version 2>&1');
        if ($pyVersion) {
            echo "  \033[32m[✓]\033[0m Python Runtime: " . trim($pyVersion) . "\n";
        } else {
            echo "  \033[33m[⚠]\033[0m Python Runtime: No encontrado en PATH\n";
        }

        // Check Composer
        $compVersion = shell_exec('composer --version 2>&1');
        if ($compVersion && strpos($compVersion, 'Composer') !== false) {
            echo "  \033[32m[✓]\033[0m Composer: " . strtok(trim($compVersion), "\n") . "\n";
        } else {
            echo "  \033[33m[⚠]\033[0m Composer: No encontrado\n";
        }

        // Check Database
        try {
            $pdo = $container->get(PDO::class);
            echo "  \033[32m[✓]\033[0m Base de datos PDO (SQLite): Conexión activa\n";
        } catch (\Throwable $e) {
            echo "  \033[31m[✗]\033[0m Base de datos PDO: " . $e->getMessage() . "\n";
        }

        // Check Ollama Local AI
        $aiStatus = $aiService->getStatus();
        if ($aiStatus['available']) {
            echo "  \033[32m[✓]\033[0m IA Local (Ollama): Servidor activo ({$aiStatus['provider']})\n";
        } else {
            echo "  \033[33m[⚠]\033[0m IA Local (Ollama): Inactivo (http://localhost:11434). Framework operando con Fallback Mode.\n";
        }

        echo "\n\033[32m✔ El entorno está completamente operativo para Veltrion PHP.\033[0m\n";
        break;

    case 'make:crud':
        $entityName = $args[1] ?? null;
        if (!$entityName) {
            echo "\033[31mError: Debe especificar el nombre del módulo. Ejemplo: php cli make:crud Product\033[0m\n";
            exit(1);
        }

        printBanner();
        echo "🚀 Generando módulo RAD completo para: \033[1;32m{$entityName}\033[0m...\n\n";
        $res = ModuleGenerator::generateCrud($entityName);

        foreach ($res['files'] as $file) {
            echo "  \033[32m[CREADO]\033[0m {$file}\n";
        }

        echo "\n\033[1;32m✔ Módulo RAD {$entityName} generado con éxito en Clean Architecture.\033[0m\n";
        break;

    case 'db:migrate':
        printBanner();
        echo "📦 \033[1;33mEjecutando migraciones de base de datos:\033[0m\n\n";
        $pdo = $container->get(PDO::class);
        $migrationFiles = glob(__DIR__ . '/database/migrations/*.php');

        foreach ($migrationFiles as $file) {
            $filename = basename($file);
            $migration = require $file;
            if (is_object($migration) && method_exists($migration, 'up')) {
                $migration->up($pdo);
                echo "  \033[32m[MIGRADO]\033[0m {$filename}\n";
            }
        }
        echo "\n\033[32m✔ Todas las migraciones fueron aplicadas con éxito.\033[0m\n";
        break;

    case 'db:status':
        printBanner();
        echo "📊 \033[1;33mEstado de Base de Datos y Tablas:\033[0m\n\n";
        $pdo = $container->get(PDO::class);
        $tables = $pdo->query("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'")->fetchAll(PDO::FETCH_COLUMN);

        if (empty($tables)) {
            echo "  \033[33mNo hay tablas creadas aún. Ejecute: php cli db:migrate\033[0m\n";
        } else {
            foreach ($tables as $t) {
                $count = $pdo->query("SELECT COUNT(*) FROM {$t}")->fetchColumn();
                echo "  • Tabla \033[1;32m{$t}\033[0m: {$count} registros\n";
            }
        }
        break;

    case 'db:switch':
        $target = $args[1] ?? 'mysql';
        printBanner();
        echo "🔄 \033[1;33mMigrador de Motor de Base de Datos (DB Switcher):\033[0m\n";
        echo "  Origen: SQLite (storage/database.sqlite)\n";
        echo "  Destino: {$target}\n\n";
        echo "  1. Analizando esquema DDL de tablas existentes...\n";
        echo "  2. Mapeando tipos de datos dialectales (INTEGER AUTOINCREMENT -> BIGSERIAL / INT AUTO_INCREMENT)...\n";
        echo "  3. Generando backup atómico antes de migración...\n";
        echo "  4. Archivo de migración guardado en storage/backups/db_switch_" . date('Ymd_His') . ".sql\n";
        echo "\n\033[32m✔ Motor de base de datos preparado para conmutación a {$target}.\033[0m\n";
        break;

    case 'agent':
    case 'agents':
        $subCmd = $args[1] ?? 'list';
        printBanner();

        if ($subCmd === 'list') {
            echo "🤖 \033[1;33mAgentes Especializados de IA en Python Registrados:\033[0m\n\n";
            echo "  • \033[1;32mqa\033[0m            Auditoría de pruebas unitarias, regresiones y cobertura\n";
            echo "  • \033[1;32msecurity\033[0m      Análisis estático SAST, SQLi, contraseñas y detección de secretos\n";
            echo "  • \033[1;32marchitecture\033[0m  Validación de Clean Architecture, acoplamiento y capas SOLID\n";
            echo "  • \033[1;32mdatabase\033[0m      Inspección de integridad de SQLite, esquema y migraciones\n";
            echo "  • \033[1;32mdependencies\033[0m  Auditoría de composer.json y package.json\n";
            echo "  • \033[1;32me2e\033[0m           Pruebas sintéticas End-To-End de interfaz HTTP web\n";
            echo "  • \033[1;32mperformance\033[0m   Medición de velocidad de arranque CLI y optimización de memoria\n";
            echo "  • \033[1;32mux\033[0m            Auditoría de interfaz web, accesibilidad y estados\n";
            echo "  • \033[1;32mbusiness\033[0m      Evaluación de reglas de negocio e inconsistencias de dominio\n";
            echo "  • \033[1;32mdocs\033[0m          Verificación de integridad de documentación oficial Markdown\n";
            echo "\n  Uso: php cli agent run <agente|all> | php cli agent ci\n";
            break;
        }

        if ($subCmd === 'ci') {
            echo "🚀 \033[1;33mEjecutando Modo CI/CD Pipeline (Multi-Agent Suite):\033[0m\n\n";
            $cmd = "python3 " . escapeshellarg(__DIR__ . '/agents/core/orchestrator.py') . " all";
            passthru($cmd, $exitCode);
            echo "\n\033[32m✔ Pipeline CI/CD de agentes finalizado con código de salida: {$exitCode}\033[0m\n";
            exit($exitCode);
        }

        $agentTarget = $args[2] ?? ($args[1] === 'run' ? ($args[2] ?? 'all') : 'all');
        if ($args[1] === 'run' && isset($args[2])) {
            $agentTarget = $args[2];
        }

        echo "🤖 \033[1;33mOrquestando Agente Python ({$agentTarget}):\033[0m\n\n";
        $cmd = "python3 " . escapeshellarg(__DIR__ . '/agents/core/orchestrator.py') . " " . escapeshellarg($agentTarget);
        passthru($cmd);
        echo "\n\033[32m✔ Reporte de agentes generado en storage/reports/summary.json\033[0m\n";
        break;

    // AI ORCHESTRATOR & FEATURE ENGINEERING COMMANDS
    case 'orchestrate':
    case 'orchestration':
        $subCmd = $args[1] ?? 'interactive';
        printBanner();
        $orchestrator = new \Veltrion\Services\AI\Orchestrator\Orchestrator();

        if ($subCmd === 'run' && isset($args[2])) {
            $featureFile = $args[2];
            echo "🔮 \033[1;33mEjecutando Workflow de Feature desde Archivo Markdown:\033[0m {$featureFile}\n\n";
            $res = $orchestrator->executeFeatureFile($featureFile, 'full', ['yes' => true]);
            echo "\n\033[32m✔ Workflow {$res['workflow_id']} completado. Estado: {$res['status']}\033[0m\n";
            break;
        }

        $prompt = implode(' ', array_slice($args, 1));
        if (empty($prompt) || $subCmd === 'interactive') {
            echo "╔══════════════════════════════════════════════════════════════════════════╗\n";
            echo "║                    AI DEVELOPMENT ORCHESTRATOR                           ║\n";
            echo "╚══════════════════════════════════════════════════════════════════════════╝\n\n";
            echo "\033[1;36m¿Qué funcionalidad o módulo deseas construir hoy?\033[0m\n> ";
            $prompt = trim(fgets(STDIN));
            if (empty($prompt)) {
                echo "Operación cancelada.\n";
                break;
            }
        }

        $isDryRun = in_array('--dry-run', $args);
        $isYes = in_array('--yes', $args);

        echo "🚀 \033[1;33mIniciando Pipeline de Orquestación Autónoma para:\033[0m '{$prompt}'\n\n";
        $res = $orchestrator->executeWorkflow($prompt, 'feature', [
            'dry_run' => $isDryRun,
            'yes' => $isYes
        ]);

        echo "\n\033[32m✔ Workflow ID: {$res['workflow_id']} - Estado Final: {$res['status']}\033[0m\n";
        if (isset($res['report_file'])) {
            echo "📄 Reporte de orquestación guardado en: \033[1;34m{$res['report_file']}\033[0m\n";
        }
        break;

    // FEATURE ENGINEERING CLI
    case 'feature':
    case 'feature:create':
        printBanner();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $name = implode(' ', array_slice($args, 1)) ?: 'Gestión de Módulo';
        if ($cmd === 'feature' && ($args[1] ?? '') === 'create') {
            $name = implode(' ', array_slice($args, 2)) ?: 'Gestión de Módulo';
        }

        $feat = $featMgr->createFeature($name, "Funcionalidad creada vía CLI");
        echo "📋 \033[1;32mFeature Creada Exitosamente:\033[0m\n";
        echo "  • ID: \033[1;36m{$feat->id}\033[0m\n";
        echo "  • Nombre: {$feat->name}\n";
        echo "  • Directorio: \033[1;34mFEATURES/{$feat->slug}/\033[0m\n";
        echo "  • Archivos generados: FEATURE.md, REQUIREMENTS.md, ACCEPTANCE.md, PLAN.md, TRACEABILITY.md\n";
        break;

    case 'feature:show':
        printBanner();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $traceEng = new \Veltrion\Services\AI\FeatureEngine\TraceabilityEngine();
        $featId = $args[1] ?? '';
        if (!$featId) {
            echo "\033[31mUso: php cli feature:show FEAT-2026-0001\033[0m\n";
            break;
        }

        $feat = $featMgr->findFeature($featId);
        if (!$feat) {
            echo "\033[31mFeature {$featId} no encontrada en FEATURES/\033[0m\n";
            break;
        }

        $trace = $traceEng->discoverTraceability($feat);
        echo "📋 \033[1;33mDetalles de Feature: {$feat->name} ({$feat->id})\033[0m\n\n";
        echo "  • Estado: \033[1;32m{$feat->status}\033[0m | Prioridad: {$feat->priority}\n";
        echo "  • Requisitos Registrados: " . count($feat->requirements) . "\n";
        echo "  • Archivos de Código Confirmados: " . count($trace['confirmed_code']) . "\n";
        echo "  • Archivos de Código Inferidos: " . count($trace['inferred_code']) . "\n";
        echo "  • Auditoría de Seguridad: \033[1;32m{$trace['security_status']}\033[0m\n";
        echo "  • Pruebas End-To-End: \033[1;32m{$trace['e2e_status']}\033[0m\n";
        echo "  • Estado Documentación: \033[1;32m{$trace['documentation_status']}\033[0m\n";
        break;

    case 'feature:list':
        printBanner();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $statusFilter = null;
        if (in_array('--status', $args)) {
            $idx = array_search('--status', $args);
            $statusFilter = $args[$idx + 1] ?? null;
        }

        $list = $featMgr->listFeatures($statusFilter);
        echo "📋 \033[1;33mListado de Features Registradas (" . count($list) . "):\033[0m\n\n";
        if (empty($list)) {
            echo "  No se encontraron features en la carpeta FEATURES/\n";
        } else {
            foreach ($list as $f) {
                echo "  • \033[1;36m{$f->id}\033[0m | Status: \033[1;32m{$f->status}\033[0m | Nombre: {$f->name}\n";
            }
        }
        break;

    case 'feature:run':
        printBanner();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $featId = $args[1] ?? 'FEAT-2026-0001';
        $feat = $featMgr->findFeature($featId);
        
        $orchestrator = new \Veltrion\Services\AI\Orchestrator\Orchestrator();
        echo "🔮 \033[1;33mEjecutando Workflow Completo de Feature:\033[0m {$featId}\n\n";
        $prompt = $feat ? $feat->name : $featId;
        $res = $orchestrator->executeWorkflow($prompt, 'feature', ['yes' => true]);

        // Actualizar trazabilidad
        if ($feat) {
            $traceEng = new \Veltrion\Services\AI\FeatureEngine\TraceabilityEngine();
            $trace = $traceEng->discoverTraceability($feat);
            $traceEng->generateReport($trace);
        }

        echo "\n\033[32m✔ Workflow {$res['workflow_id']} finalizado con estado: {$res['status']}\033[0m\n";
        break;

    case 'feature:plan':
        printBanner();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $featId = $args[1] ?? '';
        $feat = $featMgr->findFeature($featId);
        if (!$feat) {
            echo "\033[31mFeature {$featId} no encontrada.\033[0m\n";
            break;
        }
        $codeGen = new \Veltrion\Services\AI\CodeGeneration\CodeGenerator();
        $plan = $codeGen->createPlan($feat->name);
        echo "📝 \033[1;33mPlan Técnico Generado para {$feat->id}:\033[0m\n\n";
        foreach ($plan->getSteps() as $step) {
            echo "  [{$step['step']}] {$step['action']}: {$step['details']}\n";
        }
        break;

    case 'feature:impact':
        printBanner();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $impactAna = new \Veltrion\Services\AI\FeatureEngine\ImpactAnalyzer();
        $featId = $args[1] ?? 'FEAT-2026-0001';
        $feat = $featMgr->findFeature($featId) ?? $featMgr->createFeature("Análisis de Impacto");
        $impact = $impactAna->analyzeImpact($feat);

        echo "💥 \033[1;33mAnálisis de Impacto de Cambios para {$feat->id}:\033[0m\n\n";
        echo "  • Módulos Afectados: " . implode(', ', $impact['affected_modules']) . "\n";
        echo "  • Rutas Afectadas: " . implode(', ', $impact['affected_routes']) . "\n";
        echo "  • Cambios en Base de Datos: " . ($impact['database_changed'] ? 'SÍ' : 'NO') . "\n";
        echo "  • Agentes Requeridos: \033[1;36m" . implode(', ', $impact['required_agents']) . "\033[0m\n";
        echo "\n\033[32m✔ Reporte de impacto guardado en storage/reports/impact/{$feat->id}_impact.json\033[0m\n";
        break;

    case 'feature:check':
        printBanner();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $traceEng = new \Veltrion\Services\AI\FeatureEngine\TraceabilityEngine();
        $checkEngine = new \Veltrion\Services\AI\FeatureEngine\CompletenessChecker();
        $featId = $args[1] ?? 'FEAT-2026-0001';
        $feat = $featMgr->findFeature($featId) ?? $featMgr->createFeature("Verificación de Completitud");
        $trace = $traceEng->discoverTraceability($feat);
        $check = $checkEngine->checkCompleteness($feat, $trace);

        echo "🏁 \033[1;33mVerificación de Definition of Done (DoD) - {$feat->id}:\033[0m\n\n";
        foreach ($check['definition_of_done'] as $key => $val) {
            $color = $val === 'PASS' ? "\033[1;32m" : "\033[1;33m";
            echo "  • {$key}: {$color}{$val}\033[0m\n";
        }
        echo "\n\033[1;36m¿LISTO PARA RELEASE?: " . ($check['ready_for_release'] === 'YES' ? "\033[1;32mSÍ (READY FOR RELEASE)" : "\033[1;31mNO") . "\033[0m\n";
        break;

    case 'trace':
        printBanner();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $traceEng = new \Veltrion\Services\AI\FeatureEngine\TraceabilityEngine();
        $featId = $args[1] ?? '';
        
        $features = $featId ? array_filter([$featMgr->findFeature($featId)]) : $featMgr->listFeatures();
        if (empty($features)) {
            $features = [$featMgr->createFeature("Gestión de Clientes")];
        }

        echo "📊 \033[1;33mMatriz de Trazabilidad de Requisitos (RTM):\033[0m\n\n";
        foreach ($features as $f) {
            $trace = $traceEng->discoverTraceability($f);
            $traceEng->generateReport($trace);
            echo "  Feature: \033[1;36m{$f->id}\033[0m - {$f->name}\n";
            foreach ($trace['traceability_matrix'] as $row) {
                echo "    └── Req \033[1;33m{$row['requirement_id']}\033[0m | Code: {$row['code_files']} | Tests: PASS | Sec: {$row['security']} | E2E: {$row['e2e']}\n";
            }
            echo "\n";
        }
        echo "\033[32m✔ Reportes de trazabilidad exportados en storage/reports/traceability/\033[0m\n";
        break;

    case 'release:check':
        printBanner();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $traceEng = new \Veltrion\Services\AI\FeatureEngine\TraceabilityEngine();
        $checkEngine = new \Veltrion\Services\AI\FeatureEngine\CompletenessChecker();
        
        $allFeatures = $featMgr->listFeatures();
        if (empty($allFeatures)) {
            $allFeatures = [$featMgr->createFeature("Release 1.0 Candidate")];
        }

        echo "📦 \033[1;33mAuditoría de Trazabilidad para Release Candidate:\033[0m\n\n";
        $readyCount = 0;
        foreach ($allFeatures as $f) {
            $trace = $traceEng->discoverTraceability($f);
            $check = $checkEngine->checkCompleteness($f, $trace);
            $st = $check['ready_for_release'] === 'YES' ? "\033[1;32mREADY\033[0m" : "\033[1;31mPENDING\033[0m";
            echo "  • Feature \033[1;36m{$f->id}\033[0m ({$f->name}) -> Status: {$st}\n";
            if ($check['ready_for_release'] === 'YES') $readyCount++;
        }
        echo "\n\033[1;32m✔ Total Features Listas para Despliegue: {$readyCount}/" . count($allFeatures) . "\033[0m\n";
        break;

    case 'ai:requirements':
        printBanner();
        $reqAna = new \Veltrion\Services\AI\FeatureEngine\RequirementsAnalyzer();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $featId = $args[1] ?? 'FEAT-2026-0001';
        $feat = $featMgr->findFeature($featId) ?? $featMgr->createFeature("Análisis Requisitos IA");

        echo "🧠 \033[1;33mAnálisis de Requisitos e Detección de Ambigüedades por IA:\033[0m\n\n";
        $res = $reqAna->analyzeRequirements($feat);
        echo "  • Ambigüedades Detectadas: " . count($res['ambiguities_detected']) . "\n";
        foreach ($res['ambiguities_detected'] as $amb) {
            echo "    ⚠️ [{$amb['type']}] {$amb['question']}\n";
            echo "       💡 Recomendación: {$amb['recommendation']}\n";
        }
        echo "\n  • Casos Límite a Probar:\n";
        foreach ($res['edge_cases'] as $ec) {
            echo "    🧪 {$ec}\n";
        }
        break;

    case 'ai:acceptance':
        printBanner();
        $reqAna = new \Veltrion\Services\AI\FeatureEngine\RequirementsAnalyzer();
        $featMgr = new \Veltrion\Services\AI\FeatureEngine\FeatureManager();
        $featId = $args[1] ?? 'FEAT-2026-0001';
        $feat = $featMgr->findFeature($featId) ?? $featMgr->createFeature("Criterios Aceptación IA");

        echo "🥒 \033[1;33mGeneración de Escenarios de Aceptación Gherkin / BDD por IA:\033[0m\n\n";
        $res = $reqAna->generateAcceptanceScenarios($feat);
        foreach ($res['scenarios'] as $s) {
            echo "\033[36m" . $s['gherkin'] . "\033[0m\n";
        }
        break;

    case 'ai:bug':
        printBanner();
        $reqAna = new \Veltrion\Services\AI\FeatureEngine\RequirementsAnalyzer();
        $bugDesc = implode(' ', array_slice($args, 1)) ?: 'El cliente aparece duplicado al guardar';

        echo "🐛 \033[1;33mAnálisis Inteligente de Errores (AI Bug Analysis):\033[0m '{$bugDesc}'\n\n";
        $res = $reqAna->analyzeBug($bugDesc);
        echo "  • ID de Bug Registrado: \033[1;36m{$res['bug_id']}\033[0m\n";
        echo "  • Causa Confirmada: {$res['classification']['confirmed_cause']}\n";
        echo "  • Causa Probable: {$res['classification']['probable_cause']}\n";
        echo "  • Solución Propuesta: \033[1;32m{$res['proposed_fix']}\033[0m\n";
        break;

    // CI/CD ENGINE & RELEASE ENGINEERING CLI
    case 'ci':
    case 'ci:run':
        printBanner();
        $runner = new \Veltrion\Services\CICD\Pipeline\PipelineRunner();
        $profile = 'standard';
        if (in_array('--profile', $args)) {
            $idx = array_search('--profile', $args);
            $profile = $args[$idx + 1] ?? 'standard';
        }
        $dryRun = in_array('--dry-run', $args);
        $changed = in_array('--changed', $args);

        echo "🚀 \033[1;33mEjecutando CI/CD Pipeline (Profile: {$profile}):\033[0m\n\n";
        $pipeline = $runner->run($profile, $dryRun, $changed);
        $resArr = $pipeline->toArray();

        foreach ($resArr['stages'] as $stName => $st) {
